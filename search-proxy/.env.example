# Copy to .env (gitignored) and populate. Never commit the actual .env.

# ==============================================================================
# 1. Local Search (SearXNG)
# ==============================================================================
SEARXNG_BASE_URL=http://localhost:8080

# ==============================================================================
# 2. LLM Configuration (Universal / OpenAI-Compatible)
# ==============================================================================
# Temperature: 0.0 to 0.4 for factual tasks and grounded RAG (default: 0.2)
LLM_TEMPERATURE=0.2

# --- DEFAULT OPTION: Google Gemini (via OpenAI-compatible endpoint) ---
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=your-gemini-api-key-here
LLM_MODEL=gemini-2.5-flash

# --- ALTERNATIVE OPTION: OpenAI ---
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=your-openai-api-key
# LLM_MODEL=gpt-4o-mini

# --- MULTI-MODEL AGGREGATOR OPTION: OpenRouter (openrouter.ai) ---
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=your-openrouter-api-key
# LLM_MODEL=openai/gpt-4o-mini  # or anthropic/claude-3-5-haiku, meta-llama/llama-3.3-70b-instruct, deepseek/deepseek-chat

# --- LOCAL MODEL OPTION: LM Studio / Ollama per ADR 0003 ---
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_API_KEY=not-needed
# LLM_MODEL=qwen2.5-7b-instruct
